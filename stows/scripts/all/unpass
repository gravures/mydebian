#!/usr/bin/env bash
# unpass - drop-in replacement for pass with built-in caching
# Caches decrypted values to ~/.cache/unpass/cached to avoid
# repeated GPG decryption overhead (~1.5s per call).
# Cache TTL defaults to3600s (1 hour), configurable via UNPASS_CACHE_TTL.

set -euo pipefail

CacheDir="$HOME/.cache/unpass"
CacheFile="$CacheDir/cached"
CacheTTL="${UNPASS_CACHE_TTL:-3600}"

mkdir -p "$CacheDir"

path="${1:?Usage: unpass <pass-path>}"

# Read existing cache into associative array
declare -A cache
if [[ -f "$CacheFile" ]]; then
	while IFS=: read -r p ts b64; do
		[[ -n "$p" ]] && cache["$p"]="${ts}:${b64}"
	done <"$CacheFile"
fi

# Check for fresh cache entry
now=$(date +%s)
if [[ -n "${cache[$path]:-}" ]]; then
	IFS=: read -r ts b64 <<<"${cache[$path]}"
	age=$((now - ts))
	if ((age < CacheTTL)); then
		echo "$b64" | base64 -d
		exit 0
	fi
fi

# Cache miss — decrypt via pass
value=$(pass show "$path") || exit 1

# Update cache
ts=$(date +%s)
b64=$(echo -n "$value" | base64)
cache["$path"]="${ts}:${b64}"

# Write cache file atomically
tmpfile=$(mktemp "$CacheDir/.cached.XXXXXX")
for key in "${!cache[@]}"; do
	echo "${key}:${cache[$key]}"
done >"$tmpfile"
chmod 600 "$tmpfile"
mv "$tmpfile" "$CacheFile"

echo "$value"
