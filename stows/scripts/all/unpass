#!/usr/bin/env bash
# unpass - drop-in replacement for pass with built-in caching
# Caches decrypted values to ~/.cache/unpass/cached to avoid
# repeated GPG decryption overhead (~1.5s per call).
# Cache TTL defaults to3600s (1 hour), configurable via UNPASS_CACHE_TTL.

set -euo pipefail

CACHE_DIR="${HOME}/.cache/unpass"
CACHE_TTL="${UNPASS_CACHE_TTL:-3600}"
CACHE_FILE=
CACHED_B64_VALUE=

# load cached value if ttl has not yet expired
function load_cache() {
	local now timestamp

	if [[ -f "${CACHE_FILE}" ]]; then
		now=$(date +%s)
		timestamp=$(stat --format '%Y' "${CACHE_FILE}")
		if (($((now - timestamp)) < CACHE_TTL)); then
			CACHED_B64_VALUE=$(<"${CACHE_FILE}")
			return
		else
			rm "${CACHE_FILE}" || :
		fi
	fi
	return 1
}

# Write cache file atomically
function write_cache() {
	local value=${1:?missing <value> parameter}

	CACHED_B64_VALUE="$(printf '%s' "${value}" | base64)"
	printf '%b' "${CACHED_B64_VALUE}" >"${CACHE_FILE}"
	chmod 600 "${CACHE_FILE}"
}

# encode path to cache fileneme
function encode_path() {
	local path="${1:?missing <path> parameter}"
	CACHE_FILE=${CACHE_DIR}/$(printf '%b' "${path//\//\x0}" | base64)
}

function print_value() {
	printf '%s\n' "$(printf '%b' "${CACHED_B64_VALUE}" | base64 -d)"
}

function main() {
	local path="${1:?Usage: unpass <pass-path>}"

	mkdir -p "${CACHE_DIR}"
	encode_path "${path}"
	if load_cache; then
		print_value
		exit
	fi

	# Cache miss — decrypt via pass
	local value
	value=$(pass show "${path}") || exit 1
	write_cache "${value}"
	print_value
	exit
}

main "${@}"
