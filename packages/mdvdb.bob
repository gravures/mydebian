# shellcheck disable=SC2034
# shellcheck source=../libs/bob/cargo_git_installer.sh
# source cargo_git_installer.sh
source base_installer.sh

REPO='https://github.com/geckse/markdown-vdb.git'
PKG_NAME=mdvdb
PROGRAM=mdvdb
DESC='A filesystem-native vector database built around Markdown files. For AGENTS and MEMORY in mind. CLI first, folder based, no servers, no containers. Build with Rust for Performance.'
LICENSE=(MIT)
BUILD_DEPS=()
RUNTIME_DEPS=()

function checkout() {
	local tag=$1

	git submodule init skills web-component app tesseract-skills examples
	git fetch --tags --quiet &&
		git checkout "${tag}"
	git submodule update skills web-component app tesseract-skills examples
}

function prepare() {
	rustup override set stable
	rustup update stable
}

function build() { return; }

function package() {
	mkdir -p "${PKG_DIR}${PREFIX}"

	cargo install --path . --root "${PKG_DIR}${PREFIX}"

	# cleanup metadata generated by cargo
	rm -f "${PKG_DIR}${PREFIX}"/.crates*.*
}

function clean() {
	cargo clean
}

pre_install() { return; }
pre_upgrade() { return; }
pre_remove() { return; }
post_install() { return; }
post_upgrade() { return; }
post_remove() { return; }
