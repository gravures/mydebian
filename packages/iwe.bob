# shellcheck disable=SC2034
# shellcheck source=../libs/bob/cargo_git_installer.sh
source base_installer.sh

REPO=https://github.com/iwe-org/iwe.git
PROGRAM=iwe
PKG_NAME='iwe'
DESC='Markdown knowledge graph — LSP for your editor, CLI + MCP memory for your AI agents'
LICENSE=(Apache-2.0)
BUILD_DEPS=()
RUNTIME_DEPS=()

function prepare() {
	rustup override set stable
	rustup update stable
}

function build() {
	cargo build --release
}

function package() {
	install -D -t "${PKG_DIR}${PREFIX}/bin" target/release/iwe
	install -D -t "${PKG_DIR}${PREFIX}/bin" target/release/iwes
	install -D -t "${PKG_DIR}${PREFIX}/bin" target/release/iwec
}

function clean() {
	cargo clean
}

pre_install() { return; }
pre_upgrade() { return; }
pre_remove() { return; }
post_install() { return; }
post_upgrade() { return; }
post_remove() { return; }
